# Basic nix-shell for Android development (API 28+, build-only).
# Usage: nix-shell
#
# Provides: JDK 17, Android SDK (build-tools, platform-tools, NDK r27),
#           CMake, and all necessary environment variables for Gradle builds.
# Android SDK licenses are accepted by default (set to false if you decline).

{ pkgs ? import <nixpkgs> { config.allowUnfree = true; }
, licenseAccepted ? true
}:

let
  android = {
    versions = {
      cmdLineToolsVersion = "13.0";
      platformTools       = "35.0.2";
      buildTools          = "35.0.0";
      ndk                 = [ "27.0.12077973" ];
      cmake               = "3.22.1";
    };

    # API 35 = Android 15. Only the compileSdk platform is needed; the app
    # targets minSdk 28 via AGP which doesn't require older SDK platforms.
    # Keeping this small also limits system-image downloads to one image.
    platforms = [ "35" ];

    # x86_64 only: needed for the emulator on an x86_64 host. Real-device ABIs
    # don't need SDK components beyond the NDK/build-tools, which are separate.
    abis = [ "x86_64" ];
  };

  androidEnv = pkgs.callPackage <nixpkgs/pkgs/development/mobile/androidenv> {
    inherit pkgs licenseAccepted;
  };

  androidComposition = androidEnv.composeAndroidPackages {
    cmdLineToolsVersion  = android.versions.cmdLineToolsVersion;
    platformToolsVersion = android.versions.platformTools;
    buildToolsVersions   = [ android.versions.buildTools ];
    platformVersions     = android.platforms;
    abiVersions          = android.abis;

    includeSources       = true;
    includeSystemImages  = true;
    includeEmulator      = true;

    # Google APIs Play Store image for the emulator (API 35 = Android 15).
    # System image versions follow platformVersions ("35").
    systemImageTypes     = [ "google_apis_playstore" ];

    includeNDK           = true;
    ndkVersions          = android.versions.ndk;
    cmakeVersions        = [ android.versions.cmake ];

    useGoogleAPIs        = false;
    includeExtras        = [];
  };

  androidSdk = androidComposition.androidsdk;
  platformTools = androidComposition.platform-tools;
  jdk = pkgs.jdk17;

sdkRoot = "${androidSdk}/libexec/android-sdk";

in
pkgs.mkShell {
  name = "android-dev";

  packages = [ androidSdk platformTools jdk pkgs.gradle pkgs.gnumake ];

  LANG    = "C.UTF-8";
  LC_ALL  = "C.UTF-8";
  JAVA_HOME = jdk.home;

  ANDROID_SDK_ROOT = sdkRoot;
  ANDROID_NDK_ROOT = "${sdkRoot}/ndk-bundle";

  # Force AGP to use the nix-built, NixOS-compatible aapt2 from the SDK
  # instead of the dynamically-linked binary AGP downloads from Maven.
  # (ORG_GRADLE_PROJECT_* env vars become Gradle project properties.)
  "ORG_GRADLE_PROJECT_android.aapt2FromMavenOverride" =
    "${sdkRoot}/build-tools/${android.versions.buildTools}/aapt2";

  shellHook = ''
    # Prepend CMake to PATH
    cmake_root="$(echo "$ANDROID_SDK_ROOT/cmake/${android.versions.cmake}"*/)"
    export PATH="$cmake_root/bin:$PATH"

    # Generate local.properties for Gradle / Android Studio
    cat > local.properties <<EOF
    # Auto-generated by nix-shell — do not edit manually.
    sdk.dir=$ANDROID_SDK_ROOT
    ndk.dir=$ANDROID_NDK_ROOT
    cmake.dir=$cmake_root
    EOF

    echo "Android dev shell ready."
    echo "  SDK:    $ANDROID_SDK_ROOT"
    echo "  NDK:    $ANDROID_NDK_ROOT"
    echo "  JDK:    $JAVA_HOME"
    echo "  CMake:  $cmake_root"
  '';
}
